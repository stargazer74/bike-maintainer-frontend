# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf on container start.
# Only variables set in the container environment are substituted (BACKEND_HOST, NGINX_RESOLVER); nginx's own
# $variables stay as they are.

# Keep X-Forwarded-Proto/-Host from an outer TLS proxy; without one, fall back to this hop's values.
map $http_x_forwarded_proto $bm_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}
map $http_x_forwarded_host $bm_forwarded_host {
    default $http_x_forwarded_host;
    ''      $host;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # The only container exposed to the outside: /api/ goes to the backend in the internal Docker network, so the
    # backend needs no published port. ^~ keeps the static-asset regex below from matching API paths.
    location ^~ /api/ {
        # Resolve the backend at request time via Docker's DNS: nginx starts even if the backend isn't up yet and
        # follows a recreated backend container to its new IP. With a variable, proxy_pass forwards the original
        # URI unchanged (/api/v1/...).
        resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
        set $bm_backend http://${BACKEND_HOST};
        proxy_pass $bm_backend;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $bm_forwarded_proto;
        proxy_set_header X-Forwarded-Host $bm_forwarded_host;

        # No uploads in the API; nginx must not cache API responses (the backend sets its own Cache-Control).
        client_max_body_size 1m;
        proxy_cache off;
    }

    # Angular router fallback — unknown paths resolve client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|woff2?|svg|png|jpg|jpeg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
