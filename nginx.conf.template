# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf on container start.
# Only variables set in the container environment are substituted (BACKEND_HOST, NGINX_RESOLVER); nginx's own
# $variables stay as they are.

# Keep X-Forwarded-Proto/-Host from an outer TLS proxy; without one, fall back to this hop's values.
map $http_x_forwarded_proto $bm_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}
map $http_x_forwarded_host $bm_forwarded_host {
    default $http_x_forwarded_host;
    ''      $host;
}

# Trace ID per request: nginx's $request_id (32 random hex characters) is a valid W3C trace ID. The backend takes it
# over from the traceparent header (its log lines carry it as traceId), and the access log below writes it as
# trace_id=…, so the lines of one request can be found in both logs. The parent span ID is the first half of it;
# flag 00: not sampled, nothing is exported. A traceparent sent by the client is always replaced.
map $request_id $bm_traceparent {
    "~^(?<bm_span_id>[0-9a-f]{16})" "00-$request_id-$bm_span_id-00";
}

# The image's default format "main" plus the trace ID.
log_format bm_main '$remote_addr - $remote_user [$time_local] "$request" '
                   '$status $body_bytes_sent "$http_referer" '
                   '"$http_user_agent" "$http_x_forwarded_for" trace_id=$request_id';

# Same as bm_main, but without the query string: the template search (/api/v1/vehicle-templates?make=…&model=…&year=…)
# carries terms typed by users, which must not end up in the log together with the client IP. Used for /api/.
log_format bm_api '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent" "$http_x_forwarded_for" trace_id=$request_id';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # No nginx version in the Server header and on error pages.
    server_tokens off;

    access_log /var/log/nginx/access.log bm_main;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # The only container exposed to the outside: /api/ goes to the backend in the internal Docker network, so the
    # backend needs no published port. ^~ keeps the static-asset regex below from matching API paths.
    location ^~ /api/ {
        # No query strings in the access log (see bm_api).
        access_log /var/log/nginx/access.log bm_api;

        # Resolve the backend at request time via Docker's DNS: nginx starts even if the backend isn't up yet and
        # follows a recreated backend container to its new IP. With a variable, proxy_pass forwards the original
        # URI unchanged (/api/v1/...).
        resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
        set $bm_backend http://${BACKEND_HOST};
        proxy_pass $bm_backend;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $bm_forwarded_proto;
        proxy_set_header X-Forwarded-Host $bm_forwarded_host;
        proxy_set_header traceparent $bm_traceparent;

        # No uploads in the API; nginx must not cache API responses (the backend sets its own Cache-Control).
        client_max_body_size 1m;
        proxy_cache off;

        # Spring Security sends these two as well; hide the backend's copies so the response carries each only once
        # (the server-level security headers above also apply here).
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;

        # The trace ID back to the client: on a server error the web and Android apps show its start as error ID,
        # which users can quote in a report. Also on nginx's own errors (502/504 while the backend is down), hence
        # always. An add_header here replaces the server-level ones, so the security headers are included again.
        add_header X-Request-Id $request_id always;
        include /etc/nginx/snippets/security-headers.conf;

        # The one exception: a vehicle export file (Epic #82) may have up to 5 MB, the backend enforces the same
        # limit. The proxy and response headers above are inherited; set and proxy_pass are not and must be repeated.
        location = /api/v1/vehicles/import {
            set $bm_backend http://${BACKEND_HOST};
            proxy_pass $bm_backend;
            client_max_body_size 5m;
        }
    }

    # Payment page of Paddle (default payment link): the same index.html, but with the relaxed policy that lets
    # Paddle.js run. The app always opens it with a full page load (backend checkout URL, Paddle's emails), so other
    # pages never get this policy. try_files serves the file within this location, so its headers apply.
    location = /abo/bezahlen {
        include /etc/nginx/snippets/payment-security-headers.conf;
        try_files /index.html =404;
    }

    # Angular router fallback — unknown paths resolve client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|woff2?|svg|png|jpg|jpeg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
