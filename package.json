{
  "name": "bike-maintainer-frontend",
  "version": "0.20.0-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "bddgen && playwright test",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json",
    "generate:api": "openapi-generator-cli generate -i ../bike-maintainer-api/src/main/resources/maintenance-api.yaml -g typescript-angular -o src/app/api-client --additional-properties=ngVersion=22.1.8,stringEnums=true,fileNaming=kebab-case,withInterfaces=true --type-mappings=set=Array",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fontsource/inter": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "altcha": "^3.5.0",
    "material-symbols": "^0.48.3",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  }
}
