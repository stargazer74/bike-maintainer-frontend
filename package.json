    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
